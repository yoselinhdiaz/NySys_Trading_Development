//@version=5
// ==============================================================================
//  Nysys Adaptive ALMA  v0.02
//
//  Trend-following overlay: an ALMA basis ribbon (open and close, EMA-smoothed)
//  with volatility-adaptive bands. The band width is a short-term Mean Absolute
//  Deviation scaled to a standard-deviation equivalent (x 1.4826), EMA-smoothed,
//  and multiplied by a factor between Min and Max according to the volatility
//  rank over the lookback window.
//
//  Signals (closed bar, no repaint):
//    BUY  when close crosses above the upper band and the trend was not up
//    SELL when close crosses below the lower band and the trend was not down
//
//  Trade levels (visual only): entry, stop = ATR x multiplier, TP1 / TP2 at the
//  configured risk/reward, with hit markers.
//
//  Outputs for other scripts (Data Window): Basis Open, Basis Close, Upper Band,
//  Lower Band, Buy Signal, Sell Signal (1 = signal, 0 = none).
//
//  (c) Nysys Market Solutions. For educational purposes only; not financial advice.
// ==============================================================================

indicator("Velocity ALMA", shorttitle = "Velocity", overlay = true, max_bars_back = 300, max_labels_count = 500, max_lines_count = 500)

// ---- Basis -------------------------------------------------------------------
gBasis = "Basis"
basisLength    = input.int(34, "Basis Length (short-term)", minval = 1, group = gBasis)
almaOffset     = input.float(0.65, "ALMA Offset", minval = 0, maxval = 1, step = 0.01, group = gBasis)
almaSigma      = input.float(20.0, "ALMA Sigma", minval = 0.1, step = 0.5, group = gBasis)
basisSmoothing = input.int(4, "Basis Smoothing EMA", minval = 1, group = gBasis)

// ---- Volatility (Mean Absolute Deviation) ---------------------------------------
gVol = "Volatility"
volLength       = input.int(5, "Vol Length (short-term)", minval = 1, group = gVol)
volSmoothLength = input.int(5, "Vol Smoothing EMA", minval = 1, group = gVol)
volRankLookback = input.int(100, "Volatility Rank Lookback", minval = 2, group = gVol)
madScale        = input.float(1.4826, "MAD scale (MAD to sigma)", minval = 0.0001, step = 0.0001, group = gVol,
     tooltip = "MAD to standard-deviation scale: 1.4826 = 1 / Phi^-1(0.75).")

// ---- Bands ---------------------------------------------------------------------
gBands = "Bands"
minMult = input.float(0.8, "Min Multiplier", minval = 0.001, step = 0.1, group = gBands)
maxMult = input.float(1.8, "Max Multiplier", minval = 0.001, step = 0.1, group = gBands)
adaptiveBands = input.bool(true, "Adaptive Bands", group = gBands,
     tooltip = "ON: the multiplier scales between Min and Max with the volatility rank. OFF: Min multiplier only.")

// ---- Display -------------------------------------------------------------------
gDisplay = "Display (solo visual, no cambia senales)"
colorCandles  = input.bool(false, "Color candles by trend", group = gDisplay)
showRibbon    = input.bool(true, "Show basis ribbon", group = gDisplay)
showBands     = input.bool(false, "Show adaptive bands", group = gDisplay)
showSignals   = input.bool(true, "Show BUY / SELL labels", group = gDisplay)
upColor = input.color(#00e600, "Up color", group = gDisplay)
dnColor = input.color(#ff1e56, "Down color", group = gDisplay)
labelAtrLen    = input.int(14, "ATR Length (label offset)", minval = 1, group = gDisplay)
labelAtrOffset = input.float(0.25, "ATR Offset (label multiplier)", step = 0.05, group = gDisplay)

gLevels = "TP1 / TP2 / Stop Loss (solo visual)"
showLevels      = input.bool(true, "Show Trade Levels", group = gLevels)
showLevelLabels = input.bool(true, "Show Level Price Labels", group = gLevels)
showHitMarkers  = input.bool(true, "Show Level Hit Markers", group = gLevels)
slAtrLen  = input.int(14, "SL ATR Length", minval = 1, group = gLevels)
slAtrMult = input.float(1.8, "ATR Multiplier", step = 0.1, group = gLevels)
tp1RR     = input.float(0.5, "TP1 Risk/Reward", step = 0.1, group = gLevels)
tp2RR     = input.float(1.5, "TP2 Risk/Reward", step = 0.1, group = gLevels)

// ---- Basis: ALMA smoothed once by a short EMA ----------------------------------
basisClose = ta.ema(ta.alma(close, basisLength, almaOffset, almaSigma), basisSmoothing)
basisOpen  = ta.ema(ta.alma(open, basisLength, almaOffset, almaSigma), basisSmoothing)

// ---- Volatility: mean absolute deviation around its own short SMA, EM smoothed --
madRaw = ta.sma(math.abs(close - ta.sma(close, volLength)), volLength)
vol    = ta.ema(madRaw, volSmoothLength)

// ---- Volatility rank over the PREVIOUS `volRankLookback` bars (na skipped) ------
float cnt = 0.0
float volRank = na
if bar_index >= volRankLookback and not na(vol)
    cnt := 0.0
    for i = 1 to volRankLookback
        if not na(vol[i]) and vol[i] <= vol
            cnt += 1
    volRank := cnt / volRankLookback

// ---- Adaptive bands centred on Basis Close -------------------------------------
adaptFactor = adaptiveBands ? minMult + (maxMult - minMult) * volRank : minMult
bandHalf    = bar_index >= volRankLookback ? madScale * vol * adaptFactor : na
upperBand   = basisClose + bandHalf
lowerBand   = basisClose - bandHalf

// ---- Signals: closed-bar trend machine, de-duplicated on same-side crosses -----
bool upCross = not na(upperBand) and not na(upperBand[1]) and close > upperBand and close[1] <= upperBand[1]
bool dnCross = not na(lowerBand) and not na(lowerBand[1]) and close < lowerBand and close[1] >= lowerBand[1]

var int trend = 0
bool buySignal  = upCross and trend != 1
bool sellSignal = dnCross and trend != -1

if upCross
    trend := 1
else if dnCross
    trend := -1

// ---- Outputs ---------------------------------------------------------------------
// ---- Signal outputs (Data Window, readable by other scripts as a source) ----------
// Data Window only, so the 0/1 values never squash the price scale.
plot(buySignal ? 1 : 0, title = "Buy Signal", display = display.data_window)
plot(sellSignal ? 1 : 0, title = "Sell Signal", display = display.data_window)

// ---- Visuals ---------------------------------------------------------------------
trendCol = trend == 1 ? upColor : trend == -1 ? dnColor : color.gray
pBO    = plot(basisOpen, title = "Basis Open", color = showRibbon ? trendCol : na, linewidth = 4)
pBC    = plot(basisClose, title = "Basis Close", color = showRibbon ? trendCol : na, linewidth = 4)
fill(pBO, pBC, color = showRibbon ? trendCol : na, title = "Ribbon fill")
// Gradient from the ribbon to the price, strong at the price and fading into the ribbon.
pPx    = plot(close, title = "Price (fill anchor)", color = na, display = display.none, editable = false)
gTop   = math.max(close, basisClose)
gBot   = math.min(close, basisClose)
fill(pPx, pBC, gTop, gBot, showRibbon ? color.new(trendCol, close >= basisClose ? 55 : 100) : na,
     showRibbon ? color.new(trendCol, close >= basisClose ? 100 : 55) : na, title = "Ribbon gradient")
pUpper = plot(upperBand, title = "Upper Band", color = showBands ? color.new(trendCol, 25) : na, linewidth = 1)
pLower = plot(lowerBand, title = "Lower Band", color = showBands ? color.new(trendCol, 25) : na, linewidth = 1)
barcolor(colorCandles and trend != 0 ? trendCol : na, title = "Candle color")

labelAtr = ta.atr(labelAtrLen)
if showSignals and buySignal
    label.new(bar_index, low - labelAtr * labelAtrOffset, "BUY", style = label.style_label_up, color = upColor, textcolor = color.white, size = size.small)
if showSignals and sellSignal
    label.new(bar_index, high + labelAtr * labelAtrOffset, "SELL", style = label.style_label_down, color = dnColor, textcolor = color.white, size = size.small)

// ---- Trade levels of the last signal (visual only, same rules as the Signal Logger) ----
slAtr = ta.atr(slAtrLen)
var int   tDir   = 0
var float tEntry = na
var float tSL    = na
var float tTP1   = na
var float tTP2   = na
var int   tBar   = na
var bool  tHit1  = false
var bool  tDone  = false
bool hitTP1Now = false
bool hitTP2Now = false
bool hitSLNow  = false
if tDir != 0 and not tDone and bar_index > tBar
    bool slHit  = tDir == 1 ? low <= tSL : high >= tSL
    bool tp1Hit = tDir == 1 ? high >= tTP1 : low <= tTP1
    bool tp2Hit = tDir == 1 ? high >= tTP2 : low <= tTP2
    if slHit
        hitSLNow := true
        tDone    := true
    else
        if tp1Hit and not tHit1
            tHit1     := true
            hitTP1Now := true
        if tp2Hit
            hitTP2Now := true
            tDone     := true

var box   bxWin  = na
var box   bxLoss = na
var line  lnE    = na
var line  lnT1   = na
var line  lnT2   = na
var line  lnSL   = na
var label lbE    = na
var label lbT1   = na
var label lbT2   = na
var label lbSL   = na
if buySignal or sellSignal
    tDir   := buySignal ? 1 : -1
    float r = slAtr * slAtrMult
    tEntry := close
    tSL    := close - tDir * r
    tTP1   := close + tDir * r * tp1RR
    tTP2   := close + tDir * r * tp2RR
    tBar   := bar_index
    tHit1  := false
    tDone  := false
    if showLevels
        box.delete(bxWin)
        box.delete(bxLoss)
        line.delete(lnE)
        line.delete(lnT1)
        line.delete(lnT2)
        line.delete(lnSL)
        bxWin  := box.new(bar_index, math.max(tEntry, tTP2), bar_index + 1, math.min(tEntry, tTP2), border_color = na, bgcolor = color.new(upColor, 88))
        bxLoss := box.new(bar_index, math.max(tEntry, tSL), bar_index + 1, math.min(tEntry, tSL), border_color = na, bgcolor = color.new(dnColor, 88))
        lnE    := line.new(bar_index, tEntry, bar_index + 1, tEntry, color = color.orange, style = line.style_dashed, width = 2)
        lnT1   := line.new(bar_index, tTP1, bar_index + 1, tTP1, color = color.new(upColor, 40), width = 1)
        lnT2   := line.new(bar_index, tTP2, bar_index + 1, tTP2, color = upColor, width = 1)
        lnSL   := line.new(bar_index, tSL, bar_index + 1, tSL, color = dnColor, width = 1)
// The active trade's zones and lines grow with each bar until it closes (SL or TP2).
if showLevels and tDir != 0 and not na(bxWin) and (not tDone or hitSLNow or hitTP2Now)
    int xr = bar_index + 1
    box.set_right(bxWin, xr)
    box.set_right(bxLoss, xr)
    line.set_x2(lnE, xr)
    line.set_x2(lnT1, xr)
    line.set_x2(lnT2, xr)
    line.set_x2(lnSL, xr)
if showLevels and showLevelLabels and barstate.islast
    label.delete(lbE)
    label.delete(lbT1)
    label.delete(lbT2)
    label.delete(lbSL)
if showLevels and showLevelLabels and barstate.islast and tDir != 0 and not tDone
    int xl = bar_index + 2
    lbT2 := label.new(xl, tTP2, "TP2 (" + str.tostring(tp2RR) + "R)\n" + str.tostring(tTP2, format.mintick), style = label.style_label_left, color = upColor, textcolor = color.black, size = size.small)
    lbT1 := label.new(xl, tTP1, "TP1 (" + str.tostring(tp1RR) + "R)\n" + str.tostring(tTP1, format.mintick), style = label.style_label_left, color = color.new(upColor, 40), textcolor = color.black, size = size.small)
    lbE  := label.new(xl, tEntry, "ENTRY\n" + str.tostring(tEntry, format.mintick), style = label.style_label_left, color = color.orange, textcolor = color.black, size = size.small)
    lbSL := label.new(xl, tSL, "STOP LOSS\n" + str.tostring(tSL, format.mintick), style = label.style_label_left, color = dnColor, textcolor = color.white, size = size.small)

plotshape(showHitMarkers and hitTP1Now ? tTP1 : na, title = "TP1 Hit Marker", style = shape.circle, location = location.absolute, color = color.new(upColor, 30), size = size.small, text = "TP1", textcolor = color.gray)
plotshape(showHitMarkers and hitTP2Now ? tTP2 : na, title = "TP2 Hit Marker", style = shape.circle, location = location.absolute, color = upColor, size = size.small, text = "TP2", textcolor = color.gray)
plotshape(showHitMarkers and hitSLNow ? tSL : na, title = "Stop Loss Hit Marker", style = shape.xcross, location = location.absolute, color = dnColor, size = size.small, text = "SL", textcolor = color.gray)

alertcondition(buySignal, title = "Nysys Adaptive ALMA BUY", message = "Nysys Adaptive ALMA: BUY {{ticker}} {{interval}} close={{close}}")
alertcondition(sellSignal, title = "Nysys Adaptive ALMA SELL", message = "Nysys Adaptive ALMA: SELL {{ticker}} {{interval}} close={{close}}")
